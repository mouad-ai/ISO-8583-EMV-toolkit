<idea-plugin>
    <id>io.github.mouadai.cardmsg</id>
    <name>Card Message Toolkit</name>
    <vendor url="https://github.com/mouad-ai/ISO-8583-EMV-toolkit">Mouad EL MRABATE</vendor>
    <!-- Freemium: optional="true" keeps the plugin usable without a license; see CardMsgLicense.
         PCARDMSGTOOLKIT is the requested code; confirm it when JetBrains approves the paid plugin. release-version must
         match the start of the plugin version (1.0.x -> 10), or the Plugin Verifier rejects it. -->
    <product-descriptor code="PCARDMSGTOOLKIT" release-date="20260926" release-version="10" optional="true"/>

    <description><![CDATA[
    Decode, build and diff ISO 8583 messages and EMV BER-TLV data (field 55 and more) without leaving your IDE.
    <ul>
      <li>100% offline: no network calls, no telemetry, sensitive data masked by default.</li>
      <li>Works with your own message specs (dialects) for each processor.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Autocomplete and validation for dialect files; everything else works without the JSON plugin. -->
    <depends optional="true" config-file="cardmsg-json.xml">com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Card Message Toolkit"
                    anchor="right"
                    icon="/icons/cardmsgToolWindow.svg"
                    factoryClass="io.github.mouadai.cardmsg.plugin.CardMsgToolWindowFactory"/>
        <consoleFilterProvider implementation="io.github.mouadai.cardmsg.plugin.CardMsgConsoleFilterProvider"/>
        <applicationConfigurable parentId="tools"
                                 id="io.github.mouadai.cardmsg.settings"
                                 displayName="Card Message Toolkit"
                                 instance="io.github.mouadai.cardmsg.plugin.CardMsgConfigurable"/>
        <editorNotificationProvider implementation="io.github.mouadai.cardmsg.plugin.dialect.DialectFileNotificationProvider"/>
    </extensions>

    <actions>
        <action id="CardMsg.ImportJposPackager"
                class="io.github.mouadai.cardmsg.plugin.jpos.ImportJposPackagerAction"
                text="Import jPOS Packager as Card Message Toolkit Dialect..."
                description="Convert a jPOS GenericPackager XML file into a Card Message Toolkit dialect in .cardmsg/dialects">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <group id="CardMsg.DecodeSelection" text="Card Message Toolkit" popup="true">
            <action id="CardMsg.DecodeSelectionAsIso"
                    class="io.github.mouadai.cardmsg.plugin.DecodeSelectionAsIsoAction"
                    text="Decode as ISO 8583"
                    description="Decode the selected hex, base64 or text as an ISO 8583 message"/>
            <action id="CardMsg.DecodeSelectionAsEmv"
                    class="io.github.mouadai.cardmsg.plugin.DecodeSelectionAsEmvAction"
                    text="Decode as EMV TLV"
                    description="Decode the selected hex or base64 as EMV BER-TLV data"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
        </group>
    </actions>

    <projectListeners>
        <listener class="io.github.mouadai.cardmsg.plugin.dialect.DialectVfsListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="io.github.mouadai.cardmsg.plugin.dialect.DialectBannerRefresher"
                  topic="io.github.mouadai.cardmsg.plugin.dialect.DialectsChangedListener"/>
    </projectListeners>
</idea-plugin>
