<idea-plugin>
    <id>io.github.mouadai.octet</id>
    <name>Octet</name>
    <vendor url="https://github.com/mouad-ai/ISO-8583-EMV-toolkit">Mouad EL MRABATE</vendor>
    <!-- Freemium: optional="true" keeps the plugin usable without a license; see OctetLicense.
         The code is a placeholder until JetBrains Marketplace assigns one. release-version must
         match the start of the plugin version (1.0.x -> 10), or the Plugin Verifier rejects it. -->
    <product-descriptor code="POCTET" release-date="20260926" release-version="10" optional="true"/>

    <description><![CDATA[
    Decode, build and diff ISO 8583 messages and EMV BER-TLV data (field 55 and more) without leaving your IDE.
    <ul>
      <li>100% offline: no network calls, no telemetry, sensitive data masked by default.</li>
      <li>Works with your own message specs (dialects) for each processor.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Autocomplete and validation for dialect files; everything else works without the JSON plugin. -->
    <depends optional="true" config-file="octet-json.xml">com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Octet"
                    anchor="right"
                    icon="/icons/octetToolWindow.svg"
                    factoryClass="io.github.mouadai.octet.plugin.OctetToolWindowFactory"/>
        <consoleFilterProvider implementation="io.github.mouadai.octet.plugin.OctetConsoleFilterProvider"/>
        <applicationConfigurable parentId="tools"
                                 id="io.github.mouadai.octet.settings"
                                 displayName="Octet"
                                 instance="io.github.mouadai.octet.plugin.OctetConfigurable"/>
        <editorNotificationProvider implementation="io.github.mouadai.octet.plugin.dialect.DialectFileNotificationProvider"/>
    </extensions>

    <actions>
        <action id="Octet.ImportJposPackager"
                class="io.github.mouadai.octet.plugin.jpos.ImportJposPackagerAction"
                text="Import jPOS Packager as Octet Dialect..."
                description="Convert a jPOS GenericPackager XML file into an Octet dialect in .octet/dialects">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <group id="Octet.DecodeSelection" text="Octet" popup="true">
            <action id="Octet.DecodeSelectionAsIso"
                    class="io.github.mouadai.octet.plugin.DecodeSelectionAsIsoAction"
                    text="Decode as ISO 8583"
                    description="Decode the selected hex, base64 or text as an ISO 8583 message"/>
            <action id="Octet.DecodeSelectionAsEmv"
                    class="io.github.mouadai.octet.plugin.DecodeSelectionAsEmvAction"
                    text="Decode as EMV TLV"
                    description="Decode the selected hex or base64 as EMV BER-TLV data"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
        </group>
    </actions>

    <projectListeners>
        <listener class="io.github.mouadai.octet.plugin.dialect.DialectVfsListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="io.github.mouadai.octet.plugin.dialect.DialectBannerRefresher"
                  topic="io.github.mouadai.octet.plugin.dialect.DialectsChangedListener"/>
    </projectListeners>
</idea-plugin>
